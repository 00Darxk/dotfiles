{
    "custom/updates": {
        //"format": " {}",
        "format": " {}",
        "escape": false,
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/getupdates.sh",
        "restart-interval": 3600,
        "on-click": "kitty --title \"$(jq -r '.\"waybar.modules.custom.updates.on-click\"' $HOME/.config/dotlang/lang.jsonc)\" sh -c ~/.config/waybar/scripts/installupdates.sh",
        "on-click-right": "kitty --title \"$(jq -r '.\"waybar.modules.custom.updates.on-click-right\"' $HOME/.config/dotlang/lang.jsonc)\" sh -c ~/.config/waybar/scripts/listpackages.sh",
        "tooltip": true
    }
}