{
    "custom/tailscale": {
        "format": "{icon}",
        "format-icons": [""],
        "escape": false,
        "return-type":"json",
        "exec":"~/.config/waybar/scripts/tailscaleinfo.sh",
        "interval": 60,
        "on-click": "kitty --title \"$(jq -r '.\"waybar.modules.custom.tailscale.on-click\"' $HOME/.config/dotlang/lang.jsonc) $(cat ~/.config/.secrets/hostname.txt)\" sh -c ~/.config/waybar/scripts/connectssh.sh",
        "on-click-right": "kitty --title \"$(jq -r '.\"waybar.modules.custom.tailscale.on-click-right\"' $HOME/.config/dotlang/lang.jsonc)\" sh -c ~/.config/waybar/scripts/addhost.sh",
        "on-scroll-up": "~/.config/waybar/scripts/cyclehost.sh +1",
        "on-scroll-down": "~/.config/waybar/scripts/cyclehost.sh -1",
        "tooltip": true
    }
}