{
    "custom/power_btn": {
        "format" : "{icon}",
        "format-icons": [""],
        //"on-click": "sh -c'(sleep 0.5s; wlogout --protocol layer-shell)' & disown",
        "on-click": "wlogout -b 6 -T 400 -B 400  --protocol layer-shell",
        "exec": "~/.config/waybar/scripts/get_tooltip.sh waybar.modules.custom.power_btn.tooltip-format",
        "return-type": "json",
        "tooltip": true
    }
}